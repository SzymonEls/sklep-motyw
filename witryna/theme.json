{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"border": {
			"radiusSizes": [
				{ "name": "Small", "slug": "small", "size": "6px" },
				{ "name": "Medium", "slug": "medium", "size": "12px" },
				{ "name": "Large", "slug": "large", "size": "20px" },
				{ "name": "Extra large", "slug": "x-large", "size": "32px" },
				{ "name": "Full", "slug": "full", "size": "999px" }
			]
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "color": "#FAF9F6", "name": "Base", "slug": "base" },
				{ "color": "#F2EFE9", "name": "Surface", "slug": "surface" },
				{ "color": "#E3DED4", "name": "Line", "slug": "line" },
				{ "color": "#161513", "name": "Contrast", "slug": "contrast" },
				{ "color": "#66625A", "name": "Muted", "slug": "muted" },
				{ "color": "#B5400F", "name": "Accent", "slug": "accent" },
				{ "color": "#F7E2D6", "name": "Accent soft", "slug": "accent-soft" },
				{ "color": "#DDF26B", "name": "Highlight", "slug": "highlight" }
			],
			"gradients": [
				{
					"name": "Shade from bottom",
					"slug": "shade-bottom",
					"gradient": "linear-gradient(180deg, rgba(0, 0, 0, 0) 35%, rgba(0, 0, 0, 0.62) 100%)"
				},
				{
					"name": "Surface to base",
					"slug": "surface-base",
					"gradient": "linear-gradient(180deg, var(--wp--preset--color--surface) 0%, var(--wp--preset--color--base) 100%)"
				},
				{
					"name": "Accent glow",
					"slug": "accent-glow",
					"gradient": "radial-gradient(120% 120% at 0% 0%, var(--wp--preset--color--accent-soft) 0%, var(--wp--preset--color--base) 60%)"
				}
			]
		},
		"custom": {
			"radius": {
				"button": "var(--wp--preset--border-radius--full)",
				"input": "var(--wp--preset--border-radius--medium)",
				"card": "var(--wp--preset--border-radius--large)",
				"media": "var(--wp--preset--border-radius--medium)",
				"badge": "var(--wp--preset--border-radius--full)"
			},
			"font": {
				"heading": "var(--wp--preset--font-family--bricolage-grotesque)",
				"heading-weight": "600",
				"heading-tracking": "-0.03em"
			},
			"transition": {
				"fast": "160ms cubic-bezier(0.2, 0.8, 0.2, 1)",
				"base": "320ms cubic-bezier(0.2, 0.8, 0.2, 1)"
			},
			"header": {
				"background": "color-mix(in srgb, var(--wp--preset--color--base) 82%, transparent)"
			}
		},
		"dimensions": {
			"aspectRatios": [
				{ "name": "Portrait - 4:5", "slug": "4-5", "ratio": "4/5" },
				{ "name": "Landscape - 5:4", "slug": "5-4", "ratio": "5/4" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1400px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Subtle",
					"slug": "subtle",
					"shadow": "0 1px 2px rgba(20, 18, 14, 0.06), 0 2px 10px rgba(20, 18, 14, 0.04)"
				},
				{
					"name": "Soft",
					"slug": "soft",
					"shadow": "0 18px 40px -18px rgba(20, 18, 14, 0.22)"
				},
				{
					"name": "Elevated",
					"slug": "elevated",
					"shadow": "0 30px 70px -24px rgba(20, 18, 14, 0.34)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "Tiny", "slug": "10", "size": "0.375rem" },
				{ "name": "2X-Small", "slug": "20", "size": "0.75rem" },
				{ "name": "X-Small", "slug": "30", "size": "clamp(1rem, 0.85rem + 0.5vw, 1.25rem)" },
				{ "name": "Small", "slug": "40", "size": "clamp(1.5rem, 1.2rem + 1vw, 2rem)" },
				{ "name": "Medium", "slug": "50", "size": "clamp(2rem, 1.4rem + 2vw, 3rem)" },
				{ "name": "Large", "slug": "60", "size": "clamp(2.75rem, 1.9rem + 3.5vw, 4.5rem)" },
				{ "name": "X-Large", "slug": "70", "size": "clamp(3.5rem, 2.2rem + 5.5vw, 7rem)" },
				{ "name": "2X-Large", "slug": "80", "size": "clamp(4.5rem, 2.5rem + 8vw, 10rem)" }
			],
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"typography": {
			"defaultFontSizes": false,
			"writingMode": false,
			"fluid": {
				"minViewportWidth": "360px",
				"maxViewportWidth": "1440px"
			},
			"fontFamilies": [
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter/inter-latin-wght-normal.woff2" ],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter/inter-latin-ext-wght-normal.woff2" ],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						},

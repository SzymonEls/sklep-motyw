						}
					]
				},
				{
					"name": "System Sans-serif",
					"slug": "system-sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif"
				}
			],
			"fontSizes": [
				{ "name": "Extra small", "slug": "x-small", "size": "0.75rem", "fluid": false },
				{ "name": "Small", "slug": "small", "size": "0.875rem", "fluid": false },
				{ "name": "Medium", "slug": "medium", "size": "1rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "name": "Large", "slug": "large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.3125rem" } },
				{ "name": "Extra large", "slug": "x-large", "size": "1.625rem", "fluid": { "min": "1.375rem", "max": "1.75rem" } },
				{ "name": "2X large", "slug": "xx-large", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.75rem" } },
				{ "name": "3X large", "slug": "xxx-large", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "4rem" } },
				{ "name": "Display", "slug": "display", "size": "4.5rem", "fluid": { "min": "2.75rem", "max": "6.25rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"right": "clamp(1.25rem, 0.75rem + 2vw, 2.5rem)",
				"bottom": "0px",
				"left": "clamp(1.25rem, 0.75rem + 2vw, 2.5rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"letterSpacing": "-0.006em",
			"lineHeight": "1.6"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "var(--wp--custom--radius--button)",
					"width": "0px"
				},
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"top": "0.95rem",
						"right": "1.6rem",
						"bottom": "0.95rem",
						"left": "1.6rem"
					}
				},
				"typography": {
					"fontFamily": "inherit",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"letterSpacing": "-0.005em",
					"lineHeight": "1.15"
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--contrast) 84%, var(--wp--preset--color--base))",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"lineHeight": "1.5"
				}
			},
			"heading": {
				"color": {
					"text": "inherit"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
					"fontWeight": "600",
					"letterSpacing": "-0.025em",
					"lineHeight": "1.1"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"letterSpacing": "-0.04em",
					"lineHeight": "1.02"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"letterSpacing": "-0.035em",
					"lineHeight": "1.06"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"letterSpacing": "-0.025em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.25"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.35"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0.08em",
					"lineHeight": "1.4",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "currentColor"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/avatar": {
				"border": {
					"radius": "var(--wp--preset--border-radius--full)"
				}
			},
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "currentColor",
							"style": "solid",
							"width": "1.5px"
						},
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--contrast)"
						},
						"spacing": {
							"padding": {
								"top": "calc(0.95rem - 1.5px)",
								"right": "calc(1.6rem - 1.5px)",
								"bottom": "calc(0.95rem - 1.5px)",
								"left": "calc(1.6rem - 1.5px)"
							}
						},
						":hover": {
							"color": {
								"background": "var(--wp--preset--color--contrast)",
								"text": "var(--wp--preset--color--base)"
							}
						}
					}
				}
			},
			"core/code": {
				"border": {
					"radius": "var(--wp--preset--border-radius--medium)"
				},
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--30)"
					}

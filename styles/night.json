{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Night",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#0E0E10",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#18181B",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#2C2C31",
					"name": "Line",
					"slug": "line"
				},
				{
					"color": "#F4F3EF",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#A3A19A",
					"name": "Muted",
					"slug": "muted"
				},
				{
					"color": "#D4F25A",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#262C12",
					"name": "Accent soft",
					"slug": "accent-soft"
				},
				{
					"color": "#7C3AED",
					"name": "Highlight",
					"slug": "highlight"
				}
			]
		},
		"custom": {
			"header": {
				"background": "color-mix(in srgb, var(--wp--preset--color--base) 78%, transparent)"
			}
		}
	},
	"styles": {
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/group": {
				"variations": {
					"section-dark": {
						"color": {
							"background": "var(--wp--preset--color--surface)",
							"text": "var(--wp--preset--color--contrast)"
						},
						"elements": {
							"heading": {
								"color": {
									"text": "var(--wp--preset--color--contrast)"
								}
							},
							"link": {
								"color": {
									"text": "var(--wp--preset--color--contrast)"
								},
								":hover": {
									"color": {
										"text": "var(--wp--preset--color--accent)"
									}
								}
							},
							"button": {
								"color": {
									"background": "var(--wp--preset--color--accent)",
									"text": "var(--wp--preset--color--base)"
								},
								":hover": {
									"color": {
										"background": "var(--wp--preset--color--contrast)",
										"text": "var(--wp--preset--color--base)"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
